# AvisTap — variables d'environnement
# Copier ce fichier en `.env.local` et remplir les valeurs.
# `.env.local` est ignoré par git : aucun secret ne doit être commité.

# --- Supabase ---------------------------------------------------------------
# Tableau de bord > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Clé service role : contourne la RLS. Utilisée UNIQUEMENT côté serveur
# (routes API, server actions). Ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -----------------------------------------------------------------
# Laisser vide pour développer sans compte Stripe : le tunnel bascule
# automatiquement en mode simulé (la commande passe directement en `pending`).
STRIPE_SECRET_KEY=
# Fourni par `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# --- Marque et application --------------------------------------------------
# Nom affiché en pied de page, dans les emails et les métadonnées.
NEXT_PUBLIC_SITE_NAME="AvisTap — La plaque avis"

# Sert à construire les URL de retour Stripe, les liens de suivi et surtout les
# liens NFC encodés sur les puces. Une valeur erronée ici produit des plaques
# qui pointent au mauvais endroit, définitivement.
# En production : https://avistap.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse de contact affichée aux clients (suivi, page 404 des liens NFC,
# pied de page) et expéditeur par défaut des emails.
NEXT_PUBLIC_SUPPORT_EMAIL=contact@avistap.fr

# --- Emails transactionnels (optionnel) -------------------------------------
# Sans clé, les envois sont journalisés et ignorés — rien ne bloque.
BREVO_API_KEY=
# Par défaut : NEXT_PUBLIC_SUPPORT_EMAIL et « AvisTap ».
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
